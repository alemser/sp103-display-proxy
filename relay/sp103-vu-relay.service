[Unit]
Description=sp103-vu-relay — VU do groove-detector para o display do SP103 (UDP)
Documentation=https://github.com/alemser/sp103-display-proxy
After=groove-detector.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sp103-vu-relay
# Só lê o socket do VU (root:groove 0660) e o arquivo do gate; não precisa de mais nada.
# Sem DynamicUser: ele força um /tmp privado, e os sockets do detector estão no /tmp de verdade.
User=nobody
Group=groove
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Abaixo da captura e do reconhecimento: o VU pode perder quadros, eles não.
Nice=5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
